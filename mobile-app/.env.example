# URL del backend Spring. Copiá este archivo a .env y ajustá según tu entorno.
#
#  - Emulador Android:        http://10.0.2.2:8081
#  - Dispositivo físico (Expo Go): http://<IP-LAN-de-tu-PC>:8081   (ej http://192.168.0.10:8081)
#  - iOS simulator / Web:     http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:8081
